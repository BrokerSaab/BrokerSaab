PORT=5000
NODE_ENV=development

# Database configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5412/brokersaab?schema=public"

# Redis Cache configuration
REDIS_URL="redis://localhost:6379"

# Token secrets
JWT_ACCESS_SECRET="brokersaab_secret_access_token_12345"
JWT_REFRESH_SECRET="brokersaab_secret_refresh_token_67890"

# Gateway integration configuration (Escrow mechanics)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Aadhaar data security (UIDAI compliance)
AADHAAR_HASH_SALT="brokersaab_aadhaar_prod_salt_change_in_production"

# AWS S3 Storage setup
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET_NAME="brokersaab-kyc-documents"
AWS_REGION="us-east-1"

# SMS OTP Gateways configuration (Verify Flow)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_VERIFY_SERVICE_SID="VA..."

# Firebase Push configurations
FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"..."}'
