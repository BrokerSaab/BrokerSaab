{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://brokersaab-backend.onrender.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://brokersaab-backend.onrender.com"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://brokersaab-backend.onrender.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://brokersaab-backend.onrender.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "",
        "ascAppId": ""
      }
    }
  }
}
